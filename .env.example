# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# HF_TOKEN is only required for gated/private repositories; public repos
# download fine without it.
HF_TOKEN=

# --- model selection --------------------------------------------------------
# scripts/02_download_model.sh downloads these files into models/gguf/ and the
# API/CLI load them via JEV_GGUF_FILE / JEV_MMPROJ_FILE. Q8_0 is the
# near-lossless quantization; any file the repo hosts also works (Q4_K_M,
# Q5_K_M, Q6_K, BF16).
#
# Default: Qwen3.8-4B-Distill (Q8_0) + its Qwen3.5-4B vision projector.
JEV_GGUF_REPO=empero-ai/Qwen3.8-4B-Distill-GGUF
JEV_GGUF_FILE=Qwen3.8-4B-Q8_0.gguf
JEV_MMPROJ_REPO=lmstudio-community/Qwen3.5-4B-GGUF
JEV_MMPROJ_FILE=mmproj-Qwen3.5-4B-BF16.gguf

# Larger alternative: Qwen3.8-9B-Distill (Q8_0). Comment the 4B block above,
# uncomment this block and re-run scripts/02_download_model.sh.
#JEV_GGUF_REPO=empero-ai/Qwen3.8-9B-Distill-GGUF
#JEV_GGUF_FILE=Qwen3.8-9B-Q8_0.gguf
#JEV_MMPROJ_REPO=lmstudio-community/Qwen3.5-9B-GGUF
#JEV_MMPROJ_FILE=mmproj-Qwen3.5-9B-BF16.gguf

# Optional runtime overrides (defaults live in config.yaml):
#JEV_DEVICE=cpu        # auto | cpu | cuda | cuda:0 | cuda:0,1
#JEV_GPU_LAYERS=20     # layers on GPU (default: fit free VRAM automatically)
#JEV_CTX_SIZE=16384    # total context across -np slots
#JEV_GGUF=/abs/path/model.gguf       # full path override, wins over _FILE
#JEV_MMPROJ=/abs/path/mmproj.gguf    # empty disables image inputs
